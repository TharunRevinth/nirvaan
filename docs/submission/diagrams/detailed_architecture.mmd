graph TD
    subgraph Roles["Stakeholder Roles"]
        Vendor["Vendor (Commercial Bidder)"]
        Officer["PSU Officer (IOCL / BPCL / ONGC)"]
        CVC["CVC Vigilance Auditor"]
        AdminRole["System Admin (Single Wallet)"]
        KeeperRole["Autonomous Keeper Bot"]
    end

    subgraph FrontendHosting["Frontend Layer (Vercel)"]
        UI["React 18 SPA (Vite + Tailwind CSS)"]
        MM["MetaMask Wallet (EIP-1193)"]
        GIGW["GIGW Accessibility Toolbar"]
        UI --- MM
        UI --- GIGW
    end

    subgraph BackendHosting["Backend Gateway & Indexer (Render)"]
        API["Express.js REST API Server"]
        AuthMid["Officer JWT & Vendor Nonce Auth"]
        Relay["Gas Relays (tech-score, awardTender)"]
        Indexer["Event Indexer (10-block batch fallback)"]
        Keeper["Embedded Keeper (openBids, finalizeTender)"]
        SQLite[("Native SQLite Database (node:sqlite)<br/><i>Rebuilt from on-chain event logs</i>")]

        API --> AuthMid
        API --> Relay
        API --> SQLite
        Indexer -->|"Indexes on-chain events"| SQLite
        Keeper -->|"Checks tender deadlines"| SQLite
    end

    subgraph Storage["Decentralized Storage Layer"]
        Pinata["Pinata Cloud IPFS Gateway"]
        IPFSRepo["IPFS Storage (Tender Notices & Technical Specs)"]
        Pinata --> IPFSRepo
    end

    subgraph Blockchain["Ethereum Sepolia Testnet"]
        RPC["Alchemy Sepolia JSON-RPC Endpoint"]
        Proxy["ERC-1967 UUPS Proxy (0xe9649E...8663)"]
        Impl["OilTenderingV1 Implementation (0xd5451f...6606)"]

        RPC --> Proxy
        Proxy -->|"delegatecall"| Impl
    end

    Vendor -->|"Connects wallet & signs txs"| MM
    Vendor -->|"Browses tenders & submits KYC"| UI
    Officer -->|"Signs in via JWT & manages tenders"| UI
    CVC -->|"Audits custody & resolves disputes"| UI
    AdminRole -->|"Authorizes contract upgrades"| Proxy

    MM -->|"Signed on-chain transactions (submitBid, revealBid, dispute, withdraw)"| RPC
    UI -->|"REST API calls (JWT / challenge nonces)"| API
    API -->|"Uploads tender notices & specs (Pinata SDK)"| Pinata
    Relay -->|"Signs officer txs with server wallet"| RPC
    Indexer -->|"Log queries (eth_getLogs)"| RPC
    Keeper -->|"State transitions (openBids, finalizeTender)"| RPC
    KeeperRole -.->|"Scheduled execution"| Keeper
