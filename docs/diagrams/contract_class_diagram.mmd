classDiagram
    class Initializable
    class UUPSUpgradeable {
        #_authorizeUpgrade(address newImplementation)
    }

    class TenderProxy {
        +constructor(address logic, bytes data)
        +_delegate(address implementation)
    }

    class OilTenderingV1 {
        +address multisigAdmin
        +address keeperAddress
        +address cvcAuditorAddress
        +address treasuryAddress
        +uint256 disputeBondAmount
        +uint256 defaultMinEMD
        +uint256 tenderCounter
        +uint256 bidCounter
        +initialize(address admin, address keeper, address cvc, address treasury, uint256 bond, uint256 emd)
        +registerPSU(address psu)
        +registerVendor(address vendor, bytes32 gstinHash, bytes32 panHash, string kycHash)
        +createTender(string ipfsHash, uint256 subDeadline, uint256 openTime, uint256 revDeadline, uint256 minEMD)
        +cancelTender(uint256 tenderId, string reason)
        +submitBid(uint256 tenderId, string encryptedBidIpfs, bytes32 bidCommitment)
        +openBids(uint256 tenderId)
        +revealBid(uint256 tenderId, uint256 bidIndex, uint256 bidAmount, bytes32 salt)
        +setTechnicalScore(uint256 tenderId, uint256 bidIndex, bool qualified, uint256 score)
        +awardTender(uint256 tenderId, address winner, uint256 winningBidId, uint256 winningBidAmount)
        +disputeTender(uint256 tenderId, string reasonIpfsHash)
        +resolveDispute(uint256 tenderId, bool upheld, string resolutionNotes)
        +resolveDisputeTimeout(uint256 tenderId)
        +finalizeTender(uint256 tenderId)
        +withdraw()
    }

    class Tender {
        +uint256 id
        +address psuAddress
        +string tenderIpfsHash
        +uint256 minEMDAmount
        +uint256 submissionDeadline
        +uint256 openingTime
        +uint256 revealDeadline
        +TenderStatus status
        +address winner
        +uint256 winningBidId
        +uint256 winningBidAmount
        +uint256 awardTimestamp
    }

    class Bid {
        +uint256 id
        +uint256 tenderId
        +address vendorAddress
        +string encryptedBidIpfsHash
        +bytes32 bidCommitment
        +uint256 submissionTime
        +uint256 bidAmount
        +BidStatus status
        +bool isTechQualified
        +uint256 techScore
        +uint256 emdDeposited
    }

    class Dispute {
        +uint256 id
        +uint256 tenderId
        +address disputingVendor
        +string reasonIpfsHash
        +uint256 timestamp
        +DisputeStatus status
        +string resolutionNotes
        +uint256 bondAmount
    }

    class VendorInfo {
        +address wallet
        +bytes32 gstinHash
        +bytes32 panHash
        +string kycDocIpfsHash
        +bool isApproved
    }

    UUPSUpgradeable <|-- OilTenderingV1
    Initializable <|-- OilTenderingV1
    TenderProxy ..> OilTenderingV1 : delegates
    OilTenderingV1 *-- Tender
    OilTenderingV1 *-- Bid
    OilTenderingV1 *-- Dispute
    OilTenderingV1 *-- VendorInfo
