# Server Port & Network
PORT=5000
NODE_ENV=production
RPC_URL=https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOY_BLOCK=0

# Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_chars
OFFICER_PRIVATE_KEY=your_officer_private_key_here
KEEPER_PRIVATE_KEY=your_keeper_private_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# IPFS Pinata Service
PINATA_JWT=your_pinata_jwt_secret_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Optional Ephemeral Seeding & Database Settings
DB_PATH=/tmp/nirvaan.db
OFFICER_SEED_JSON=[{"username":"iocl_officer","password":"change_me_immediately_123!","psu":"IOCL","officerId":"IOCL-8821","email":"iocl_officer@procurement.gov.in"}]
KEEPER_POLL_INTERVAL_S=20
